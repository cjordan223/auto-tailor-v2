{
  "name": "tex-tailor-frontend",
  "version": "1.0.0",
  "type": "module",
  "description": "Modern Vue.js frontend for tex-tailor resume customization",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "dev:server:prod": "node server/index.js",
    "dev:prod": "concurrently \"npm run dev:client\" \"npm run dev:server:prod\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.5.5",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "express-rate-limit": "^6.7.0",
    "jsonschema": "^1.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "multer": "^1.4.4-lts.1",
    "uuid": "^9.0.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vue3-dropzone": "^2.2.1",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
