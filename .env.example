# =============================================================================
# TEX-TAILOR BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for the backend server (Node.js/Express)
# Copy this file to .env in the project root and fill in your actual values.
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================

# MongoDB Atlas Connection String
# 1. Create a MongoDB Atlas account: https://cloud.mongodb.com
# 2. Create a cluster and database user
# 3. Replace <password> with your database user password
MONGODB_ATLAS_URI=mongodb+srv://username:<password>@cluster.mongodb.net/?retryWrites=true&w=majority&appName=textailor

# MongoDB Database Name (optional - defaults to 'resume_tailor')
MONGODB_DATABASE_NAME=textailor

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Backend server port (optional - defaults to 3001)
PORT=3001

# Node.js environment (development/production)
NODE_ENV=development

# Frontend URL for CORS configuration
# Development: http://localhost:3000
# Production: https://your-frontend-domain.vercel.app
FRONTEND_URL=http://localhost:3000

# =============================================================================
# AI PROVIDER API KEYS (AT LEAST ONE REQUIRED)
# =============================================================================

# Google Gemini API Key (RECOMMENDED - fastest and most reliable)
# Get your key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Mistral AI API Key (optional)
# Get your key: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Groq API Key (optional - fast inference)
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ollama Base URL (optional - for local AI models)
# Only needed if running Ollama locally
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# USER MANAGEMENT (TEMPORARY)
# =============================================================================

# Temporary User ID (will be replaced with proper authentication)
TEMP_USER_ID=user_123

# =============================================================================
# DEBUGGING & DEVELOPMENT (OPTIONAL)
# =============================================================================

# Enable database debug logging (true/false)
DEBUG_DATABASE=false

# =============================================================================
# MINIMAL SETUP (QUICK START)
# =============================================================================
# For a quick local setup, you only need:
# 1. MONGODB_ATLAS_URI (with valid password)
# 2. GEMINI_API_KEY (or any one AI provider key)
# 3. All other values can use defaults